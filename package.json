{
  "name": "citecheck",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Citation checker for research papers: existence + relevance verification.",
  "bin": {
    "citecheck": "./bin/citecheck.mjs"
  },
  "scripts": {
    "citecheck": "tsx src/cli.ts",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.int.config.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/cli.ts migrate",
    "fixtures": "tsx scripts/fixtures.ts",
    "eval:citeaudit": "tsx eval/citeaudit.ts",
    "lint": "tsc --noEmit && node scripts/check-secrets.mjs"
  },
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@huggingface/transformers": "^4.3.2",
    "@xmldom/xmldom": "^0.9.12",
    "bullmq": "^6.7.10",
    "commander": "^15.1.0",
    "drizzle-orm": "^0.45.4",
    "ioredis": "^6.1.0",
    "openai": "^7.65.0",
    "postgres": "^4.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.11",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  }
}
